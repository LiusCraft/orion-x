# Copy this file to deploy/.env and replace every CHANGE_ME value.
POSTGRES_USER=orion
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=orionx
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_SET_THE_INITIAL_ADMIN_PASSWORD
LOG_LEVEL=info
HTTP_PORT=80
# Images are published by GitHub Actions to GHCR. Use a release tag to pin a deployment.
ORION_X_IMAGE=ghcr.io/liuscraft/orion-x
ORION_X_NGINX_IMAGE=ghcr.io/liuscraft/orion-x-nginx
ORION_X_TAG=latest
